{
	"name": "Data Science Portfolio",
	"build": {
		"dockerfile": "../Dockerfile",
		"context": "..",
		"args": {
			"CONDA_ENV_NAME": "wdf"
		}
	},
	"overrideCommand": true,
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-toolsai.jupyter"
			]
		}
	},
	"forwardPorts": [8888],
	"postCreateCommand": "python -m pip install -e . && echo 'Container ready: editable install complete.'",
	"remoteUser": "root"
}
